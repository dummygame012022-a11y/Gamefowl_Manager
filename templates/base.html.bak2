<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ hdr_farm.farm_name if hdr_farm else 'Gamefowl Manager' }}{% endblock %}</title>
<link rel="stylesheet" href="{{ url_for('static', filename='css/app.css') }}">
</head>
<body>
{% set ep = request.endpoint %}
<div class="top">
  <header class="topbar">
    <a class="brand" href="{{ url_for('dashboard') }}">
      {% if hdr_logo %}<img class="brand-logo" src="{{ hdr_logo }}" alt="Logo">{% else %}<span class="brand-emoji">🐓</span>{% endif %}
      <span class="brand-text"><strong>{{ hdr_farm.farm_name if hdr_farm else 'Gamefowl Manager' }}</strong>{% if hdr_farm and hdr_farm.location %}<small>{{ hdr_farm.location }}</small>{% endif %}</span>
    </a>
    <a class="gear" href="{{ url_for('farm_profile') }}" title="Settings">⚙️</a>
  </header>
  <nav class="tabs">
    <a href="{{ url_for('dashboard') }}" class="{{ 'active' if ep == 'dashboard' }}">Dashboard</a>
    <a href="{{ url_for('breeding') }}" class="{{ 'active' if ep == 'breeding' }}">Breeding</a>
    <a href="{{ url_for('conditioning') }}" class="{{ 'active' if ep == 'conditioning' }}">Conditioning</a>
    <a href="{{ url_for('health') }}" class="{{ 'active' if ep == 'health' }}">Health</a>
    <a href="{{ url_for('tools') }}" class="{{ 'active' if ep in ('tools', 'help_page') }}">Tools &amp; Guides</a>
  </nav>
</div>
<main>
  <form class="search" action="{{ url_for('search_bird') }}" method="get">
    <input type="search" name="q" value="{{ request.args.get('q', '') if ep == 'search_bird' }}" placeholder="🔍 Search Wingband or Toe-punch...">
  </form>
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% for category, message in messages %}<div class="notice {{ category }}">{{ message }}</div>{% endfor %}
  {% endwith %}
  {% block content %}{% endblock %}
</main>
<script>document.querySelector('.tabs').scrollLeft = 0;</script>
</body>
</html>
